---
import BaseHead from '../components/BaseHead.astro';
import InstrumentRail from '../components/InstrumentRail.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  currentTag?: string;
  currentTitle?: string;
  currentMeta?: string;
}

const { title, description, image, jsonLd, currentTag, currentTitle, currentMeta } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} jsonLd={jsonLd} />
  </head>
  <body class="min-h-screen">
    <div class="lg:flex">
      <InstrumentRail currentTag={currentTag} currentTitle={currentTitle} currentMeta={currentMeta} />
      <main id="main" class="flex-1 min-w-0">
        <slot />
        <footer class="border-t border-ledger-paper-dim/25 mt-16 px-6 py-8 lg:px-12">
          <p class="font-mono text-xs text-steel">
            © {new Date().getFullYear()} Layor76 · Royal Legacy Records ·
            <a href="/contact" class="ml-1">Contact</a>
          </p>
        </footer>
      </main>
    </div>
  </body>
</html>
