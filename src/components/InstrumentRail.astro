---
import { NAV_ITEMS } from '../lib/nav';
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';

interface Props {
  currentTag?: string; // e.g. "Now playing", "Now reading"
  currentTitle?: string;
  currentMeta?: string;
}

const { currentTag, currentTitle, currentMeta } = Astro.props;
const path = Astro.url.pathname;
---

<header
  class="lg:sticky lg:top-0 lg:h-screen lg:w-52 lg:shrink-0 border-b lg:border-b-0 lg:border-r border-ledger-paper-dim/30 bg-dash-panel"
>
  <div class="flex lg:flex-col lg:h-full gap-4 lg:gap-0 overflow-x-auto lg:overflow-visible p-4 lg:p-6">
    <a
      href="/"
      class="shrink-0 flex items-center gap-2 lg:mb-8 no-underline"
      aria-label="Layor76 — home"
    >
      <Image src={logo} alt="Layor76" width={36} height={36} class="rounded-none" />
      <span class="font-display uppercase tracking-wide text-ledger-paper text-lg hidden lg:inline">
        Layor76
      </span>
    </a>

    <nav aria-label="Primary" class="shrink-0 lg:mb-10">
      <ul class="flex lg:flex-col gap-4 lg:gap-2 font-mono text-xs uppercase tracking-widest">
        {
          NAV_ITEMS.map((item) => {
            const active = path === item.href || (item.href !== '/' && path.startsWith(item.href));
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'block whitespace-nowrap py-1 border-l-2 pl-3 no-underline transition-colors',
                    active
                      ? 'border-sodium-amber text-sodium-amber-strong'
                      : 'border-transparent text-steel hover:text-ledger-paper hover:border-steel',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    {
      currentTitle && (
        <div class="shrink-0 lg:mt-auto font-mono text-[0.65rem] uppercase tracking-widest text-steel border-t border-ledger-paper-dim/20 lg:pt-4">
          {currentTag && <p class="mb-1">{currentTag}</p>}
          <p class="font-display normal-case tracking-normal text-sm text-ledger-paper leading-tight">
            {currentTitle}
          </p>
          {currentMeta && <p class="mt-1 text-signal-green">{currentMeta}</p>}
        </div>
      )
    }
  </div>
</header>
