---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const releases = (await getCollection('releases', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.releaseDate.valueOf() - a.data.releaseDate.valueOf()
);
---

<BaseLayout title="Music — Layor76" description="Albums and singles from Layor76 on Royal Legacy Records.">
  <section class="px-6 py-12 lg:px-16 lg:py-16">
    <h1 class="font-display uppercase text-3xl sm:text-4xl text-ledger-paper mb-10">Music</h1>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        releases.map((release) => (
          <a href={`/music/${release.id}`} class="group block no-underline">
            <div class="aspect-square bg-dash-panel border border-ledger-paper-dim/25 mb-3 overflow-hidden flex items-center justify-center">
              {release.data.cover ? (
                <Image
                  src={release.data.cover}
                  alt={release.data.coverAlt}
                  width={480}
                  height={480}
                  class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform"
                />
              ) : (
                <span class="font-mono text-xs text-steel px-4 text-center">TODO — cover art</span>
              )}
            </div>
            <p class="font-mono text-xs uppercase tracking-widest text-sodium-amber mb-1">
              {release.data.type}
            </p>
            <h2 class="font-display uppercase text-lg text-ledger-paper group-hover:text-sodium-amber-strong transition-colors">
              {release.data.title}
            </h2>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
