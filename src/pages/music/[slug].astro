---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TripLog from '../../components/TripLog.astro';
import AudioPlayer from '../../components/AudioPlayer.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { SITE } from '../../lib/site';

export async function getStaticPaths() {
  const releases = await getCollection('releases', ({ data }) => !data.draft);
  return releases.map((release) => ({
    params: { slug: release.id },
    props: { release },
  }));
}

const { release } = Astro.props;
const { Content } = await render(release);
const { data } = release;

const streamingLabels: Record<string, string> = {
  spotify: 'Spotify',
  appleMusic: 'Apple Music',
  youtubeMusic: 'YouTube Music',
  soundcloud: 'SoundCloud',
  bandcamp: 'Bandcamp',
};
const streamingEntries = Object.entries(data.streamingLinks).filter(([, url]) => url);

const trackEntries =
  data.tracklist?.map((track, i) => ({
    index: String(i + 1).padStart(2, '0'),
    title: track.title,
    stat: track.duration,
  })) ?? [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': data.type === 'album' ? 'MusicAlbum' : 'MusicRecording',
  name: data.title,
  datePublished: data.releaseDate.toISOString().slice(0, 10),
  byArtist: {
    '@type': 'MusicGroup',
    name: 'Layor76',
  },
  recordLabel: data.label,
};
---

<BaseLayout
  title={`${data.title} — Layor76`}
  description={data.note.slice(0, 155)}
  image={data.cover?.src}
  jsonLd={jsonLd}
  currentTag="Now viewing"
  currentTitle={data.title}
  currentMeta={data.type === 'album' ? `${trackEntries.length} tracks` : 'Single'}
>
  <article class="px-6 py-12 lg:px-16 lg:py-16 max-w-4xl">
    <a href="/music" class="font-mono text-xs uppercase tracking-widest text-steel hover:text-sodium-amber-strong no-underline">
      ← All music
    </a>

    <div class="mt-6 grid sm:grid-cols-[240px_1fr] gap-8 items-start">
      <div class="aspect-square bg-dash-panel border border-signal-green/25 flex items-center justify-center">
        {data.cover ? (
          <Image src={data.cover} alt={data.coverAlt} width={480} height={480} class="w-full h-full object-cover" />
        ) : (
          <span class="font-mono text-xs text-steel px-4 text-center">TODO — cover art</span>
        )}
      </div>
      <div>
        <p class="font-mono text-xs uppercase tracking-widest text-sodium-amber mb-2">
          {data.type} · {data.label}
        </p>
        <h1 class="font-display uppercase text-3xl sm:text-4xl text-ledger-paper mb-4 text-balance">
          {data.title}
        </h1>
        <p class="text-steel max-w-[60ch] whitespace-pre-line">{data.note}</p>

        {streamingEntries.length > 0 ? (
          <div class="flex flex-wrap gap-3 mt-6">
            {streamingEntries.map(([key, url]) => (
              <a
                href={url as string}
                class="font-mono text-xs uppercase tracking-widest px-4 py-2 border border-signal-green/40 hover:border-sodium-amber hover:text-sodium-amber-strong no-underline"
                rel="noopener"
              >
                {streamingLabels[key] ?? key}
              </a>
            ))}
          </div>
        ) : (
          <p class="font-mono text-xs text-steel mt-6">TODO — streaming links not added yet.</p>
        )}
      </div>
    </div>

    {(data.spotifyId || data.youtubeShortId) && (
      <div class="mt-8 flex flex-wrap gap-6 items-start">
        {data.spotifyId && (
          <div class="max-w-lg flex-1 min-w-[280px]">
            <AudioPlayer spotifyId={data.spotifyId} title={data.title} />
          </div>
        )}
        {data.youtubeShortId && (
          <YouTubeEmbed videoId={data.youtubeShortId} title={`${data.title} — YouTube Short`} />
        )}
      </div>
    )}

    {trackEntries.length > 0 && <TripLog label="Tracklist" entries={trackEntries} />}

    <div class="mt-10 max-w-[65ch] text-steel leading-relaxed [&>p]:mb-4">
      <Content />
    </div>
  </article>
</BaseLayout>
