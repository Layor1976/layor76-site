---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmailSignup from '../../components/EmailSignup.astro';
import TripLog from '../../components/TripLog.astro';
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { DEFAULT_CHECKOUT_URL } from '../../lib/site';

const book = await getEntry('books', 'keep-what-you-earn');
const data = book!.data;
const checkoutUrl = data.checkoutUrl ?? DEFAULT_CHECKOUT_URL;

const covers = [
  {
    index: '01',
    title: 'What actually counts as a business expense',
    stat: 'CH. 1',
  },
  {
    index: '02',
    title: 'The mileage rate vs. actual expenses — picking the one that pays',
    stat: 'CH. 2',
  },
  {
    index: '03',
    title: 'Quarterly estimated taxes, without the guesswork',
    stat: 'CH. 3',
  },
  {
    index: '04',
    title: 'Tracking that survives an audit, not just a spreadsheet you forget',
    stat: 'CH. 4',
  },
  {
    index: '05',
    title: 'Schedule C, line by line, for a driver instead of a shop owner',
    stat: 'CH. 5',
  },
  {
    index: '06',
    title: "The new tip deduction, and what it doesn't cover",
    stat: 'CH. 6',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: data.title,
  author: { '@type': 'Person', name: 'Layor76' },
  bookFormat: 'https://schema.org/EBook',
  description: data.description,
};
---

<BaseLayout
  title={`${data.title} — Layor76`}
  description={data.description}
  image={data.cover?.src}
  jsonLd={jsonLd}
  currentTag="Now reading"
  currentTitle={data.title}
  currentMeta={data.status === 'in-progress' ? 'In progress' : 'Published'}
>
  <article class="px-6 py-12 lg:px-16 lg:py-16 max-w-3xl">
    <p class="font-mono text-xs uppercase tracking-widest text-sodium-amber mb-4">
      For Spark, rideshare, and delivery drivers
    </p>
    <h1 class="font-display uppercase text-3xl sm:text-4xl lg:text-5xl leading-[1] text-ledger-paper mb-6 text-balance">
      {data.title}
    </h1>
    <p class="text-lg text-steel max-w-[56ch] mb-10">{data.tagline}</p>

    <div class="grid sm:grid-cols-[200px_1fr] gap-8 mb-14">
      <div class="aspect-[2/3] bg-dash-panel border border-ledger-paper-dim/25 flex items-center justify-center">
        {data.cover ? (
          <Image src={data.cover} alt={data.coverAlt} width={400} height={600} class="w-full h-full object-cover" />
        ) : (
          <span class="font-mono text-xs text-steel px-4 text-center">TODO — cover art</span>
        )}
      </div>
      <div class="flex flex-col justify-center gap-4">
        {checkoutUrl ? (
          <a
            href={checkoutUrl}
            rel="noopener"
            class="font-mono text-xs uppercase tracking-widest px-6 py-4 bg-sodium-amber text-night-route font-semibold text-center hover:bg-sodium-amber-strong transition-colors no-underline"
          >
            Get the book
          </a>
        ) : (
          <p class="font-mono text-xs text-steel border border-rust-belt/50 px-4 py-3">
            Not for sale yet — join the list below and you'll hear first.
          </p>
        )}
        {data.sampleChapterUrl && (
          <a
            href={data.sampleChapterUrl}
            rel="noopener"
            class="font-mono text-xs uppercase tracking-widest px-6 py-4 border border-ledger-paper-dim/50 text-ledger-paper text-center hover:border-sodium-amber hover:text-sodium-amber-strong transition-colors no-underline"
          >
            Read a free sample chapter
          </a>
        )}
      </div>
    </div>

    <section class="mb-14">
      <h2 class="font-display uppercase text-xl text-ledger-paper mb-4">Who this is for</h2>
      <p class="text-steel max-w-[62ch] leading-relaxed">
        You drive for Spark, Uber, Lyft, DoorDash, Instacart, or a mix of them. You get a 1099, not a W-2,
        and nobody at the app is going to tell you what you can write off. This book is for the driver who
        wants to stop overpaying every April and stop guessing every quarter — not for a CPA, and not for
        someone running a fleet.
      </p>
    </section>

    <section class="mb-14">
      <h2 class="font-display uppercase text-xl text-ledger-paper mb-4">What it saves you</h2>
      <p class="text-steel max-w-[62ch] leading-relaxed mb-4">
        The math, worked once: a driver logging 500 business miles a week — about 26,000 a year —
        deducts <span class="font-mono text-sodium-amber-strong">$18,850</span> at the 2026 IRS
        rate of 72.5¢/mile, before a single other expense. That's not a marketing number, it's
        what the standard mileage rate is actually worth at a realistic weekly mileage. The book
        walks the same math for your real numbers.
      </p>
      <p class="text-steel max-w-[62ch] leading-relaxed">
        TODO — replace with your own after-the-fact figure once you have one (an actual before/after
        from your own returns hits harder than any worked example).
      </p>
    </section>

    <section class="mb-14">
      <h2 class="font-display uppercase text-xl text-ledger-paper mb-4">What's covered</h2>
      <TripLog entries={covers} />
      <p class="font-mono text-xs text-steel mt-4">
        TODO — chapter list above is a placeholder structure. Confirm real chapter count and titles.
      </p>
    </section>

    <EmailSignup
      heading="Get the launch list"
      subheading="This book isn't out yet. The list is the whole point — one email when it ships, and the sample chapter goes out to this list first."
      ctaLabel="Notify me"
      tag="keep-what-you-earn"
    />
  </article>
</BaseLayout>
