---
// Generic book landing page — used for any book that doesn't have its own
// hand-built sales page (like keep-what-you-earn.astro does). Drop a new
// Markdown file in src/content/books/ and it gets a page here automatically.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const books = await getCollection('books', ({ data }) => !data.draft);
  // keep-what-you-earn has its own dedicated page at keep-what-you-earn.astro — skip it here.
  return books
    .filter((book) => book.id !== 'keep-what-you-earn')
    .map((book) => ({
      params: { slug: book.id },
      props: { book },
    }));
}

const { book } = Astro.props;
const { Content } = await render(book);
const { data } = book;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: data.title,
  author: { '@type': 'Person', name: 'Layor76' },
  bookFormat: 'https://schema.org/EBook',
  description: data.description,
};
---

<BaseLayout
  title={`${data.title} — Layor76`}
  description={data.description}
  image={data.cover?.src}
  jsonLd={jsonLd}
  currentTag="Now reading"
  currentTitle={data.title}
  currentMeta={data.status === 'in-progress' ? 'In progress' : 'Published'}
>
  <article class="px-6 py-12 lg:px-16 lg:py-16 max-w-3xl">
    <a href="/writing" class="font-mono text-xs uppercase tracking-widest text-steel hover:text-sodium-amber-strong no-underline">
      ← All writing
    </a>

    <div class="mt-6 grid sm:grid-cols-[200px_1fr] gap-8 items-start">
      <div class="aspect-[2/3] bg-dash-panel border border-signal-green/25 flex items-center justify-center">
        {data.cover ? (
          <Image src={data.cover} alt={data.coverAlt} width={400} height={600} class="w-full h-full object-cover" />
        ) : (
          <span class="font-mono text-xs text-steel px-4 text-center">TODO — cover art</span>
        )}
      </div>
      <div>
        <p class="font-mono text-xs uppercase tracking-widest text-sodium-amber mb-2">
          {data.status === 'in-progress' ? 'In progress' : 'Published'}
        </p>
        <h1 class="font-display uppercase text-3xl sm:text-4xl text-ledger-paper mb-4 text-balance">
          {data.title}
        </h1>
        <p class="text-steel max-w-[60ch] mb-4">{data.tagline}</p>
        <p class="text-steel max-w-[60ch]">{data.description}</p>

        {data.checkoutUrl && (
          <a
            href={data.checkoutUrl}
            rel="noopener"
            class="inline-block mt-6 font-mono text-xs uppercase tracking-widest px-6 py-4 bg-sodium-amber text-night-route font-semibold hover:bg-sodium-amber-strong transition-colors no-underline"
          >
            Get the book
          </a>
        )}
      </div>
    </div>

    <div class="mt-10 max-w-[65ch] text-steel leading-relaxed [&>p]:mb-4">
      <Content />
    </div>
  </article>
</BaseLayout>
