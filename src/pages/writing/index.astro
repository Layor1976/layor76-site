---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TripLog from '../../components/TripLog.astro';
import { getCollection } from 'astro:content';

// The tax book (Keep What You Earn) and its articles live on their own
// small "Tax Guide" nav tab, not here — this page is Layor76's own
// creative writing (memoir, poetry, essays), kept separate on purpose.
const books = (await getCollection('books', ({ data }) => !data.draft)).filter(
  (book) => book.id !== 'keep-what-you-earn'
);

const bookEntries = books.map((book, i) => ({
  index: String(i + 1).padStart(2, '0'),
  title: book.data.title,
  href: `/writing/${book.id}`,
  stat: book.data.status === 'in-progress' ? 'IN PROGRESS' : 'PUBLISHED',
}));
---

<BaseLayout title="Writing — Layor76" description="Books from Layor76 — the memoir, the poetry, the rest.">
  <section class="px-6 py-12 lg:px-16 lg:py-16 max-w-3xl">
    <h1 class="font-display uppercase text-3xl sm:text-4xl text-ledger-paper mb-10">Writing</h1>

    {
      bookEntries.length > 0 ? (
        <TripLog label="Books" entries={bookEntries} />
      ) : (
        <p class="font-mono text-xs text-steel mt-8">TODO — no books published yet.</p>
      )
    }
  </section>
</BaseLayout>
