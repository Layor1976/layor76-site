---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { SITE } from '../lib/site';
import heroImage from '../assets/images/hero-cinematic.jpg';

const releases = await getCollection('releases', ({ data }) => !data.draft);
const featured = releases.find((r) => r.data.featured) ?? releases[0];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  name: 'Layor76',
  url: SITE.url,
  genre: 'TODO',
};
---

<BaseLayout
  title={SITE.title}
  description={SITE.description}
  jsonLd={jsonLd}
  currentTag={featured ? 'Now playing' : undefined}
  currentTitle={featured?.data.title}
  currentMeta={featured?.data.type === 'album' ? `${featured.data.tracklist?.length ?? 0} tracks` : 'Single'}
>
  <section class="relative flex flex-col lg:flex-row lg:min-h-[85vh]">
    <div class="flex flex-col justify-center px-6 py-16 lg:px-16 lg:py-0 max-w-2xl z-10">
      <p class="font-mono text-xs uppercase tracking-widest text-sodium-amber mb-4">
        Music • Memory • Aftermath
      </p>
      <h1 class="font-display uppercase text-4xl sm:text-5xl lg:text-6xl leading-[0.95] text-ledger-paper mb-6 text-balance">
        What survived became the work.
      </h1>
      <p class="text-lg text-steel max-w-[52ch] mb-10">
        Songs pulled from the dark. Words written after the noise died down.
      </p>

      <a
        href="/music"
        class="inline-block font-mono text-xs uppercase tracking-widest px-6 py-4 bg-sodium-amber text-night-route font-semibold text-center hover:bg-sodium-amber-strong transition-colors no-underline w-fit"
      >
        Enter the music
      </a>
    </div>

    <div class="hidden lg:block lg:w-[45%] relative border-l border-signal-green/25 overflow-hidden">
      <Image
        src={heroImage}
        alt="Layor76 seen from behind, seated at a desk in a dark room, notebook open, city skyline through the window at night"
        width={900}
        height={1000}
        class="w-full h-full object-cover"
      />
    </div>
  </section>

  {
    featured && (
      <section class="px-6 pb-16 lg:px-16 max-w-4xl">
        <p class="font-mono text-xs uppercase tracking-widest text-steel mb-3">
          {featured.data.type === 'album' ? 'Current album' : 'Latest single'}
        </p>
        <a href={`/music/${featured.id}`} class="group block no-underline">
          <h2 class="font-display uppercase text-2xl sm:text-3xl text-ledger-paper group-hover:text-sodium-amber-strong transition-colors">
            {featured.data.title}
          </h2>
          <p class="text-steel mt-2 max-w-[60ch]">{featured.data.note}</p>
        </a>
      </section>
    )
  }
</BaseLayout>
