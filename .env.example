# Copy this file to .env for local development.
# Never commit the real .env file — it's already in .gitignore.

# Buttondown username (not a secret key) — powers the email capture form.
# Sign up free at buttondown.com, your username is in your account URL.
# If unset, the signup form falls back to a mailto: link instead of breaking.
BUTTONDOWN_USERNAME=

# Formspree form ID — powers the /contact page form.
# Create a free form at formspree.io; the ID is the part after /f/ in the
# endpoint URL they give you. If unset, the contact page falls back to a
# plain mailto: link instead of breaking.
FORMSPREE_ID=
